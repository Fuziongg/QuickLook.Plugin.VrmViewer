<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuickLook.Plugin.VrmViewer</AssemblyName>
    <RootNamespace>QuickLook.Plugin.VrmViewer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Authors>Fuziongg</Authors>
    <Copyright>Copyright © 2026 Fuziongg</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- all provided by QuickLook itself at runtime (HelixToolkit ships with its HelixViewer); not shipped in the .qlplugin -->
  <ItemGroup>
    <Reference Include="QuickLook.Common">
      <HintPath>lib\QuickLook.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HelixToolkit.Wpf">
      <HintPath>lib\HelixToolkit.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HelixToolkit">
      <HintPath>lib\HelixToolkit.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="QuickLook.Plugin.Metadata.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
